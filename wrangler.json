{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chris-portfolio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "christiquis.pw", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/tools", "/tools/*"]
  },
  "services": [{ "binding": "BST_TOOLS", "service": "bst-tools" }]
}
